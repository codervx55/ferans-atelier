<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ferans Atelier</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --gold: #C9A84C;
      --cream: #FDF8F2;
      --dark: #1A1209;
      --mid: #3D2B1F;
      --soft: #7A6248;
      --border: rgba(201,168,76,0.25);
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Jost', sans-serif; background: var(--cream); color: var(--dark); overflow-x: hidden; }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.2rem 2.5rem;
      background: rgba(253,248,242,0.97); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 600; letter-spacing: .2em; color: var(--gold); text-transform: uppercase; }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--mid); text-decoration: none; transition: color .3s; }
    .nav-links a:hover { color: var(--gold); }

    /* HERO — split layout: text left, white-bg photo right */
    .hero {
      display: grid; grid-template-columns: 1fr 1fr;
      min-height: 100vh; background: var(--cream);
    }
    .hero-left {
      display: flex; flex-direction: column; justify-content: center;
      padding: 9rem 4rem 4rem 5rem; background: var(--cream);
    }
    .hero-eyebrow { font-size: .68rem; letter-spacing: .4em; text-transform: uppercase; color: var(--gold); font-weight: 400; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; opacity: 0; animation: fadeUp .8s .1s ease forwards; }
    .hero-eyebrow::before { content: ''; display: block; width: 36px; height: 1px; background: var(--gold); }
    .hero-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(3rem, 5vw, 5.5rem); font-weight: 300; line-height: 1.0; color: var(--dark); margin-bottom: 1.4rem; opacity: 0; animation: fadeUp .8s .22s ease forwards; }
    .hero-title em { font-style: italic; color: var(--gold); }
    .hero-subtitle { font-size: .84rem; font-weight: 300; color: var(--soft); line-height: 1.9; max-width: 360px; margin-bottom: 2.8rem; opacity: 0; animation: fadeUp .8s .34s ease forwards; }
    .hero-cta { display: inline-flex; align-items: center; gap: 1rem; background: var(--dark); color: var(--cream); padding: 1rem 2.5rem; font-family: 'Jost', sans-serif; font-size: .72rem; letter-spacing: .25em; text-transform: uppercase; text-decoration: none; transition: background .3s; width: fit-content; font-weight: 400; opacity: 0; animation: fadeUp .8s .46s ease forwards; }
    .hero-cta:hover { background: var(--gold); color: var(--dark); }
    .hero-right { overflow: hidden; position: relative; background: #f5f5f5; }
    .hero-right img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }

    /* MARQUEE */
    .marquee-section { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: .9rem 0; overflow: hidden; background: #FAF3E8; }
    .marquee-track { display: flex; gap: 2.5rem; animation: marquee 22s linear infinite; white-space: nowrap; }
    .marquee-track span { font-size: .65rem; letter-spacing: .32em; text-transform: uppercase; color: var(--gold); font-weight: 400; flex-shrink: 0; }
    .marquee-dot { color: var(--soft) !important; }
    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* SERVICES */
    .services { padding: 8rem 5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; background: #fff; }
    .services-header { position: sticky; top: 7rem; }
    .section-label { font-size: .64rem; letter-spacing: .38em; text-transform: uppercase; color: var(--gold); font-weight: 400; margin-bottom: 1.4rem; display: flex; align-items: center; gap: .8rem; }
    .section-label::before { content: ''; width: 28px; height: 1px; background: var(--gold); }
    .services-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.4rem, 3.8vw, 3.8rem); font-weight: 300; line-height: 1.1; color: var(--dark); margin-bottom: 1.8rem; }
    .services-title em { font-style: italic; color: var(--gold); }
    .services-desc { font-size: .82rem; font-weight: 300; line-height: 1.9; color: var(--soft); max-width: 330px; }
    .service-list { display: flex; flex-direction: column; }
    .service-item { border-bottom: 1px solid rgba(201,168,76,.15); padding: 2rem 0; display: flex; align-items: flex-start; gap: 1.5rem; }
    .service-num { font-family: 'Cormorant Garamond', serif; font-size: .9rem; color: var(--gold); opacity: .7; padding-top: .2rem; flex-shrink: 0; }
    .service-name { font-family: 'Cormorant Garamond', serif; font-size: 1.45rem; font-weight: 400; color: var(--dark); margin-bottom: .4rem; }
    .service-desc-text { font-size: .76rem; font-weight: 300; color: var(--soft); line-height: 1.75; }
    .service-icon { margin-left: auto; font-size: 1rem; color: var(--gold); opacity: .35; padding-top: .3rem; }

    /* STATS */
    .about-strip { margin: 0 5rem; border: 1px solid var(--border); display: grid; grid-template-columns: 1fr 1px 1fr 1px 1fr; background: #FAF3E8; }
    .about-stat { padding: 3rem 2.5rem; text-align: center; }
    .about-stat-num { font-family: 'Cormorant Garamond', serif; font-size: 2.8rem; font-weight: 300; color: var(--gold); line-height: 1; margin-bottom: .5rem; }
    .about-stat-label { font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: var(--soft); font-weight: 300; }
    .about-divider { background: var(--border); }

    /* GALLERY — 5 images mosaic, no repeats */
    .gallery { padding: 8rem 5rem; background: var(--cream); }
    .gallery-header { text-align: center; margin-bottom: 3.5rem; }
    .gallery-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(2rem, 3.5vw, 3.2rem); font-weight: 300; color: var(--dark); }
    .gallery-title em { font-style: italic; color: var(--gold); }
    .gallery-mosaic {
      display: grid;
      grid-template-columns: 1.1fr 1fr 1fr;
      grid-template-rows: 280px 280px;
      gap: 10px;
    }
    .g-wrap { overflow: hidden; }
    .g-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; transition: transform 6s ease; }
    .g-wrap:hover img { transform: scale(1.04); }
    .g-tall { grid-row: span 2; }
    .g-wide { grid-column: span 2; }

    /* CONTACT */
    .contact { padding: 8rem 5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: center; background: #fff; }
    .contact-visual { position: relative; aspect-ratio: 3/4; overflow: hidden; }
    .contact-visual img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
    .contact-visual-frame { position: absolute; inset: 1.2rem; border: 1px solid rgba(201,168,76,.4); pointer-events: none; }
    .contact-visual-tag { position: absolute; bottom: 2rem; left: 2rem; right: 2rem; background: rgba(253,248,242,.94); backdrop-filter: blur(8px); border: 1px solid var(--border); padding: 1.1rem 1.4rem; }
    .contact-visual-tag-label { font-size: .6rem; letter-spacing: .28em; text-transform: uppercase; color: var(--gold); margin-bottom: .3rem; }
    .contact-visual-tag-text { font-family: 'Cormorant Garamond', serif; font-size: 1.05rem; font-weight: 400; color: var(--dark); }
    .contact-content { display: flex; flex-direction: column; gap: 2.5rem; }
    .contact-title { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.2rem, 3.2vw, 3.2rem); font-weight: 300; line-height: 1.15; color: var(--dark); }
    .contact-title em { font-style: italic; color: var(--gold); }
    .contact-info { display: flex; flex-direction: column; }
    .contact-row { display: flex; align-items: flex-start; gap: 1.2rem; padding: 1.4rem 0; border-bottom: 1px solid rgba(201,168,76,.12); }
    .contact-row:last-child { border-bottom: none; }
    .contact-icon { font-size: 1rem; margin-top: .1rem; flex-shrink: 0; }
    .contact-label { font-size: .62rem; letter-spacing: .25em; text-transform: uppercase; color: var(--gold); margin-bottom: .3rem; font-weight: 400; }
    .contact-value { font-size: .88rem; font-weight: 300; color: var(--mid); line-height: 1.65; }
    .contact-value a { color: var(--mid); text-decoration: none; border-bottom: 1px solid var(--border); transition: color .3s; }
    .contact-value a:hover { color: var(--gold); }
    .whatsapp-btn { display: inline-flex; align-items: center; gap: .8rem; background: #25D366; color: #fff; padding: 1rem 2.5rem; font-family: 'Jost', sans-serif; font-size: .75rem; letter-spacing: .22em; text-transform: uppercase; text-decoration: none; font-weight: 500; transition: background .3s; width: fit-content; }
    .whatsapp-btn:hover { background: #1ebe5d; }

    /* FOOTER */
    footer { border-top: 1px solid var(--border); padding: 2.5rem 5rem; display: flex; align-items: center; justify-content: space-between; background: var(--dark); }
    .footer-logo { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); }
    .footer-copy { font-size: .65rem; color: #7A6248; letter-spacing: .1em; font-weight: 300; }
    .footer-tagline { font-family: 'Cormorant Garamond', serif; font-size: .85rem; font-style: italic; color: #9A8060; }

    /* MOBILE */
    @media (max-width: 768px) {
      nav { padding: 1rem 1.2rem; }
      .nav-links { display: none; }
      .hero { grid-template-columns: 1fr; min-height: auto; }
      .hero-right { height: 100vw; }
      .hero-left { padding: 5rem 1.5rem 3rem; }
      .services { grid-template-columns: 1fr; gap: 2.5rem; padding: 5rem 1.5rem; }
      .services-header { position: static; }
      .about-strip { grid-template-columns: 1fr; margin: 0 1.5rem; }
      .about-divider { height: 1px; width: 100%; background: var(--border); }
      .gallery { padding: 5rem 1.5rem; }
      .gallery-mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: repeat(3, 48vw); }
      .g-tall { grid-row: span 1; }
      .g-wide { grid-column: span 2; }
      .contact { grid-template-columns: 1fr; gap: 3rem; padding: 5rem 1.5rem; }
      footer { flex-direction: column; gap: .8rem; padding: 2rem 1.5rem; text-align: center; }
    }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
